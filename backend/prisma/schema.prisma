generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String?
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Drafts       Draft[]
}

model Draft {
  id             String   @id @default(cuid())
  ajuNumber      String
  documentType   String
  entityType     String
  status         String   @default("DRAFT")

  header         Json?
  entities       Json?
  documents      Json?
  packages       Json?
  containers     Json?
  transport      Json?
  transactions   Json?
  goods          Json?
  declarations   Json?

  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ajuNumber, createdById])
  @@index([documentType])
  @@index([status])
  @@index([createdById])
}

model Company {
  id                String   @id @default(cuid())
  identityTypeCode  String
  identityNumber    String
  name              String
  address           String
  apiTypeCode       String
  apiNumber         String
  statusCode        String
  countryCode       String

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([identityNumber])
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  address     String
  countryCode String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model OptionCategory {
  id          String         @id @default(cuid())
  code        String         @unique
  name        String
  description String?
  options     MasterOption[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([name])
}

model MasterOption {
  id         String         @id @default(cuid())
  categoryId String
  value      String
  label      String
  sortOrder  Int            @default(0)
  isActive   Boolean        @default(true)
  category   OptionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([categoryId, value])
  @@index([categoryId, sortOrder])
  @@index([isActive])
}

model HsCode {
  id                        String   @id @default(cuid())
  code                      String   @unique
  importDutyPercentage      Decimal  @db.Decimal(5, 2)
  vatPercentage             Decimal  @db.Decimal(5, 2)
  incomeTaxPercentage       Decimal  @db.Decimal(5, 2)
  borderRestriction         String?
  postBorderRestriction     String?
  label                     String

  goodsTypes       GoodsType[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code])
}

model GoodsType {
  id         String   @id @default(cuid())
  code       String   @unique
  hsCodeId   String
  label      String

  hsCode     HsCode   @relation(fields: [hsCodeId], references: [id], onDelete: Restrict)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([hsCodeId])
}